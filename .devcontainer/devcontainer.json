{
  "name": "Persona 2 — Tradução",
  "build": { "dockerfile": "../Dockerfile", "context": "..", "target": "development" },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/p2-tool,type=bind",
  "workspaceFolder": "/workspaces/p2-tool",
  "remoteUser": "root",
  "overrideCommand": false,
  "postCreateCommand": "mkdir -p lab/iso lab/tools && cp /opt/p2-tool/vscode/*.vsix lab/tools/",
  "postAttachCommand": "bash -lc 'set -e; code --install-extension /opt/p2-tool/vscode/p2-tbf-editor.vsix --force; code --list-extensions | grep -qx dfs-Patrick.p2-tbf-editor'",
  "customizations": { "vscode": { "settings": { "files.associations": { "*.tbf": "json" } } } }
}
