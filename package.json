{
  "name": "p2_tools",
  "version": "0.0.2",
  "bin": {
    "p2_modtool": "dist/cli/mod.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfs-Patrick/persona2_translation_tool.git"
  },
  "files": [
    "game",
    "fonts",
    "dist"
  ],
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "dependencies": {
    "pngjs": "^7.0.0",
    "vm2": "^3.9.14",
    "yargs": "^17.6.2"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "@types/pngjs": "^6.0.1",
    "@types/yargs": "^17.0.18",
    "@yao-pkg/pkg": "^6.22.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "package:native": "npm run build && node scripts/package-native.js",
    "package:exe": "npm run build && node scripts/package-exe.js"
  },
  "pkg": {
    "scripts": [
      "dist/**/*.js"
    ],
    "assets": [
      "game/**/*",
      "fonts/**/*",
      "node_modules/vm2/lib/*.js"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "release/exe"
  }
}
